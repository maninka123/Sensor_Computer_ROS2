<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces><NetworkInterface address="${SENSOR_IP}" priority="default" multicast="true"/></Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
      <MaxMessageSize>1400B</MaxMessageSize>
    </General>
    <Internal>
      <SocketReceiveBufferSize min="16MiB"/>
    </Internal>
    <Discovery><Peers><Peer Address="10.20.0.10"/></Peers></Discovery>
  </Domain>
</CycloneDDS>
