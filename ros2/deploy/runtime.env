# ROS 2 uses DDS; ROS_MASTER_URI and ROS_IP intentionally absent.
SENSOR_INTERFACE=end1
SENSOR_IP=10.20.0.61
LIVOX_HOST_IP=192.168.1.50
FLIR_CAMERA_IP=10.20.0.22
FLIR_CAMERA_SERIAL=24510717
LIVOX_DEVICE_IP=192.168.1.125
LIVOX_BROADCAST_CODE=3JEDLB30015Y251
REMOTE_IP=10.20.0.10
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///workspace/ros2/deploy/cyclonedds.xml
ROSBRIDGE_ADDRESS=10.20.0.61
ROSBRIDGE_PORT=9090
# Per-process ROS logs are ephemeral and bounded by the container's /tmp tmpfs.
# Persistent operational logs are kept by the bounded journal namespace.
ROS_LOG_DIR=/tmp/ros-log
